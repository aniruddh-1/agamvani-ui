# Local-only fallback. Prefer the equivalent protected CI variables:
# ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD.
storeFile=/absolute/path/to/release.keystore
storePassword=replace-via-secret-manager
keyAlias=release
keyPassword=replace-via-secret-manager
# Android Signing Configuration for Agamvani
# Copy this file to key.properties and fill in your values
# NEVER commit key.properties to version control

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=agamvani
storeFile=../release-keystore.jks

# To generate a keystore, run:
# keytool -genkey -v -keystore release-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias agamvani
